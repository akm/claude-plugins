{
  "$schema": "https://www.schemastore.org/claude-code-marketplace.json",
  "name": "akm-claude-plugins",
  "description": "akm のチーム共有 Claude Code プラグイン集",
  "owner": {
    "name": "akm"
  },
  "plugins": [
    {
      "name": "commit-rules-guard",
      "description": "コミットルールを想起させ、動機の混在を気づかせるフック集 (セッション開始時・作業着手時・計画作成時・git commit 直前)",
      "author": {
        "name": "akm"
      },
      "category": "development",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/akm/claude-plugins",
        "path": "commit-rules-guard",
        "ref": "main"
      },
      "tags": ["git", "commit", "hooks", "workflow"]
    },
    {
      "name": "pr-teeth",
      "description": "GitHub の PR を噛み砕いて解説する。レビュー依頼の巡回と、番号や URL で指定した PR (マージ済みも可) の解説に対応し、リポジトリ別のレビュー範囲に照らした解説を HTML で作る (出力言語は設定可能、既定は日本語)",
      "author": {
        "name": "akm"
      },
      "category": "development",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/akm/claude-plugins",
        "path": "pr-teeth",
        "ref": "main"
      },
      "tags": ["github", "pull-request", "review", "i18n", "skills"]
    },
    {
      "name": "mermaid-preview",
      "description": "mermaid の図を含む HTML を生成してブラウザで見せる skill (他のスキルからの図の提示にも使う)",
      "author": {
        "name": "akm"
      },
      "category": "development",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/akm/claude-plugins",
        "path": "mermaid-preview",
        "ref": "main"
      },
      "tags": ["mermaid", "diagram", "documentation", "skill"]
    }
  ]
}
