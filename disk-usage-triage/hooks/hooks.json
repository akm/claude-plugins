{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__terminal__run_in_terminal|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/disk_usage_triage.py\" hook pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
