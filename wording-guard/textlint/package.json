{
  "name": "wording-guard-textlint",
  "private": true,
  "description": "wording-guard が使う textlint と規則集。版を固定し、コマンド wording_lint.py setup が利用者のキャッシュに npm ci で入れる",
  "license": "MIT",
  "dependencies": {
    "textlint": "15.8.0",
    "textlint-filter-rule-allowlist": "4.0.0",
    "textlint-filter-rule-comments": "1.3.0",
    "textlint-filter-rule-node-types": "1.1.0",
    "textlint-rule-ja-no-redundant-expression": "4.0.1",
    "textlint-rule-preset-ai-writing": "1.1.0",
    "textlint-rule-preset-ja-no-ai-slop": "0.1.2",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "textlint-rule-prh": "6.1.0"
  }
}
