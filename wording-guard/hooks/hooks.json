{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hook-scripts/check-wording.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
