        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hook-scripts/guard-generated.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
