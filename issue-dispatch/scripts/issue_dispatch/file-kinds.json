[
  {"pattern": "**/*.pb.go", "kind": "generated"},
  {"pattern": "**/*_generated.go", "kind": "generated"},
  {"pattern": "**/package-lock.json", "kind": "generated"},
  {"pattern": "**/npm-shrinkwrap.json", "kind": "generated"},
  {"pattern": "**/yarn.lock", "kind": "generated"},
  {"pattern": "**/pnpm-lock.yaml", "kind": "generated"},
  {"pattern": "**/go.sum", "kind": "generated"},
  {"pattern": "**/Cargo.lock", "kind": "generated"},
  {"pattern": "**/*.min.js", "kind": "generated"},
  {"pattern": "**/*.min.css", "kind": "generated"},
  {"pattern": "**/terraform.tfstate*", "kind": "generated"},

  {"pattern": "**/*.xlsx", "kind": "unknown-structure"},

  {"pattern": "**/*.png", "kind": "indivisible", "mergeable": false},
  {"pattern": "**/*.jpg", "kind": "indivisible", "mergeable": false},
  {"pattern": "**/*.jpeg", "kind": "indivisible", "mergeable": false},
  {"pattern": "**/*.gif", "kind": "indivisible", "mergeable": false},
  {"pattern": "**/*.svg", "kind": "indivisible", "mergeable": false},
  {"pattern": "**/*.ico", "kind": "indivisible", "mergeable": false},
  {"pattern": "**/*.pdf", "kind": "indivisible", "mergeable": false},
  {"pattern": "**/*.woff", "kind": "indivisible", "mergeable": false},
  {"pattern": "**/*.woff2", "kind": "indivisible", "mergeable": false},

  {"pattern": "**/migrations/**", "kind": "unstable", "split_reference": "file"},
  {"pattern": "**/*.sql", "kind": "unstable", "split_reference": "file"},
  {"pattern": "**/*.proto", "kind": "unstable", "split_reference": "file"},

  {"pattern": "**/package.json", "kind": "divisible",
   "unit_notation": {"notation": "json-key", "keys": ["dependencies", "devDependencies"]}, "split_reference": "file"},
  {"pattern": "**/*.json", "kind": "divisible", "unit_notation": "json-key", "split_reference": "file"},
  {"pattern": "**/go.mod", "kind": "divisible", "unit_notation": "go-mod-directive", "split_reference": "directory"},
  {"pattern": "**/*.md", "kind": "divisible", "unit_notation": "markdown-heading", "split_reference": "file"},
  {"pattern": "**/Makefile", "kind": "divisible", "unit_notation": "make-target", "split_reference": "file"},
  {"pattern": "**/*.toml", "kind": "divisible", "unit_notation": "toml-table", "split_reference": "file"},
  {"pattern": "**/*.yaml", "kind": "divisible", "unit_notation": "yaml-key", "split_reference": "file"},
  {"pattern": "**/*.yml", "kind": "divisible", "unit_notation": "yaml-key", "split_reference": "file"},
  {"pattern": "**/Dockerfile", "kind": "divisible", "unit_notation": "dockerfile-stage", "split_reference": "file"},
  {"pattern": "**/*.tf", "kind": "divisible", "unit_notation": "terraform-block", "split_reference": "directory"},
  {"pattern": "**/*.go", "kind": "divisible", "split_reference": "directory"},
  {"pattern": "**/*.ts", "kind": "divisible", "split_reference": "file"},
  {"pattern": "**/*.tsx", "kind": "divisible", "split_reference": "file"},
  {"pattern": "**/*.js", "kind": "divisible", "split_reference": "file"},
  {"pattern": "**/*.py", "kind": "divisible", "split_reference": "file"},
  {"pattern": "**/*.rb", "kind": "divisible", "split_reference": "file"},
  {"pattern": "**/*.css", "kind": "divisible", "split_reference": "file"}
]
