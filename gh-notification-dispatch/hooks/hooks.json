{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/gh_notification_dispatch.py\" hook session-start",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
