#!/usr/bin/env python3
"""ワーカーのテストで、PATH の先頭に claude の名前で置く偽のコマンド。

実際の claude -p の代わりに、環境変数の指示どおりに振る舞う。

- FAKE_CLAUDE_ARGS: 受けた引数 (argv[1:]) を JSON の 1 行として追記するファイル
- FAKE_CLAUDE_RECORD: 起動されたときの様子を JSON の 1 行として追記するファイル。記録するのは、
  cwd・そこでの `git rev-parse HEAD`・`git branch --show-current`・`git remote` の結果・
  FAKE_CLAUDE_REVS の各名前を `git rev-parse` で解決した SHA (解決できなければ null)・
  受けた `--settings` の値を JSON として読んだものの列・プロンプトが指す依頼文 (写し) の中身
- FAKE_CLAUDE_REVS: 記録で解決する名前を空白で区切って並べたもの (既定 main)
- FAKE_CLAUDE_PIDS: 終わらないプロセスの PID を書くファイル。テストの後片付け (メソッド tearDown) が、書かれた PID に
  KILL を送る。mode ごとに書く PID は、hang_ignore_term は自分、hang は自分と子、hang_leave_child は自分と子 2 つ、
  leave_child は残した子だけ
- FAKE_CLAUDE_STREAM: 標準出力に書く stream-json の中身を持つファイル。無ければ既定の 3 行 (init の行・Skill の呼び出し・
  result の行)。既定の init の行の permissionMode には、受けた `--permission-mode` の値を書く (受けていなければキーを書かない)
- FAKE_CLAUDE_PERMISSION_MODE: 既定の init の行の permissionMode に、受けた `--permission-mode` の値の代わりに書く値
  (auto モードを使えずに別のモードで起動した回を真似る)
- FAKE_CLAUDE_SLEEP: 結果を書く前に待つ秒数 (既定 0)
- FAKE_CLAUDE_EXIT: 終了コード (既定 0)
- FAKE_CLAUDE_REPO: 作業側の作業ツリーの絶対パス (mode が dirty_tree のとき使う)
- FAKE_CLAUDE_LOOP: 周回の置き場の絶対パス (mode が write_request と write_loop_result のとき使う)
- FAKE_CLAUDE_GIT_MARK: mode が git_config のとき、git が実行するコマンドが作る印のファイルの名前の先頭
- FAKE_CLAUDE_LINK_TARGET: mode が symlink_workspace のとき、作業場所を置き換えるシンボリックリンクの先
- FAKE_CLAUDE_OUTSIDE: mode が result_symlink_outside のとき、結果のシンボリックリンクの先 (作業場所の外のファイル)
- FAKE_CLAUDE_TERM_RECEIVED: mode が hang_ignore_term のとき、SIGTERM を受けたら作るファイル
- FAKE_CLAUDE_MODE:
    ok                    結果を正しく書く (既定)
    no_result             結果を書かない
    empty_run_id          run_id を空で書く
    no_findings           findings の行を書かない
    dirty_tree            結果を書き、作業側の作業ツリーの追跡中のファイル (README.md) を変える
    write_request         結果を書き、周回の置き場に依頼文を 1 つ置く
    write_loop_result     結果を、写しの出力先ではなく周回の置き場の出力先に直接書く
    git_config            結果を書き、複製の .git/config に core.fsmonitor・core.hooksPath・filter.<名前>.clean を、
                          .git/hooks/ に post-checkout を置く (どれも、git が実行すると印のファイルを作る)
    symlink_workspace     作業場所を別の名前に移し、元の名前を FAKE_CLAUDE_LINK_TARGET へのシンボリックリンクにしてから、
                          写しの出力先に結果を書く (結果はリンクの先に書かれる)
    leave_child           結果を書き、別のプロセスグループ (新しいセッション) で cwd が複製の中の子を残して終わる
    readonly_dir          結果を書き、複製の中に読み取り専用のディレクトリを作る
    result_symlink        結果を、複製の中のファイルへのシンボリックリンクにする
    result_symlink_outside 結果を、FAKE_CLAUDE_OUTSIDE (作業場所の外のファイル) へのシンボリックリンクにする
    result_fifo           結果を FIFO にする
    result_dir            結果をディレクトリにする
    result_large          結果を、ワーカーの上限 (1 MiB) を越える大きさで書く
    hang                  子プロセスを起動して終わらない
    hang_ignore_term      SIGTERM を受けても終わらず (受けたら FAKE_CLAUDE_TERM_RECEIVED を作る)、SIGKILL まで終わらない
    hang_leave_child      子プロセスを 2 つ (同じプロセスグループのものと、別のプロセスグループ (新しいセッション) のもの。
                          どちらも cwd は複製) 起動し、0.2 秒おきに標準出力に {"type": "fake_tick"} の行を書いて終わらない

プロンプトの「依頼文 <パス> のとおりに」から依頼文 (ワーカーが作業場所に作った写し) を見つけ、
その「出力先: `<パス>`」の行から結果の書き先を読む。
"""

import json
import os
import re
import signal
import subprocess
import sys
import time


def git(*args):
    """cwd で git を実行し、成功すれば標準出力 (前後の空白を除く) を、失敗すれば None を返す。
    テストが PATH に置く偽の git が、ワーカーの実行した git と見分けられるように、環境変数 FAKE_GIT_CALLER を fake-claude にする。"""
    r = subprocess.run(["git", *args], capture_output=True, text=True,
                       env=dict(os.environ, FAKE_GIT_CALLER="fake-claude"))
    return r.stdout.strip() if r.returncode == 0 else None


def option_values(args, name):
    return [args[i + 1] for i, a in enumerate(args) if a == name and i + 1 < len(args)]


def record_call(args, request):
    path = os.environ.get("FAKE_CLAUDE_RECORD")
    if not path:
        return
    settings = []
    for v in option_values(args, "--settings"):
        try:
            settings.append(json.loads(v))
        except ValueError:
            settings.append(v)
    try:
        with open(request, encoding="utf-8") as f:
            text = f.read()
    except (OSError, TypeError):
        text = None
    revs = {r: git("rev-parse", "--verify", "-q", r + "^{commit}")
            for r in os.environ.get("FAKE_CLAUDE_REVS", "main").split()}
    rec = {
        "cwd": os.getcwd(),
        "head": git("rev-parse", "HEAD"),
        "branch": git("branch", "--show-current"),
        "remotes": git("remote"),
        "revs": revs,
        "settings": settings,
        "request_path": request,
        "request": text,
    }
    with open(path, "a", encoding="utf-8") as f:
        f.write(json.dumps(rec, ensure_ascii=False) + "\n")


def write_pids(*pids):
    path = os.environ.get("FAKE_CLAUDE_PIDS")
    if path:
        with open(path, "w", encoding="utf-8") as f:
            f.write(" ".join(str(p) for p in pids) + "\n")


def result_lines(mode, rid, head):
    lines = [
        "skill: code-review",
        "model: opus",
        'level: "high"',
        'run_id: ""' if mode == "empty_run_id" else f'run_id: "{rid}"',
        "scope: full",
        f'head: "{head}"',
    ]
    if mode != "no_findings":
        lines.append("findings: []")
    lines.append("residual: []")
    return "\n".join(lines) + "\n"


def write_git_config(content_mark):
    """複製 (cwd) の .git に、git が後で実行するコマンドを書く。どれも実行されると content_mark-<種類> を作る。"""
    base = os.path.dirname(content_mark)

    def script(kind, passthrough=False):
        p = os.path.join(base, f"fake-hook-{kind}")
        with open(p, "w", encoding="utf-8") as f:
            f.write(f"#!/bin/sh\ntouch '{content_mark}-{kind}'\n" + ("cat\n" if passthrough else ""))
        os.chmod(p, 0o755)
        return p

    hooks_dir = os.path.join(base, "fake-hooks-dir")
    os.makedirs(hooks_dir, exist_ok=True)
    for name in ("post-checkout", "pre-commit", "post-merge", "reference-transaction"):
        p = os.path.join(hooks_dir, name)
        with open(p, "w", encoding="utf-8") as f:
            f.write(f"#!/bin/sh\ntouch '{content_mark}-hooksPath'\n")
        os.chmod(p, 0o755)
    with open(os.path.join(".git", "config"), "a", encoding="utf-8") as f:
        f.write(
            "[core]\n"
            f"\tfsmonitor = {script('fsmonitor')}\n"
            f"\thooksPath = {hooks_dir}\n"
            '[filter "fake"]\n'
            f"\tclean = {script('clean', passthrough=True)}\n"
        )
    post_checkout = os.path.join(".git", "hooks", "post-checkout")
    with open(post_checkout, "w", encoding="utf-8") as f:
        f.write(f"#!/bin/sh\ntouch '{content_mark}-post-checkout'\n")
    os.chmod(post_checkout, 0o755)
    with open(".gitattributes", "w", encoding="utf-8") as f:
        f.write("* filter=fake\n")
    with open("README.md", "a", encoding="utf-8") as f:
        f.write("clean フィルタが走るように変える\n")
    open(f"{content_mark}-written", "w").close()


def main():
    args = sys.argv[1:]
    record = os.environ.get("FAKE_CLAUDE_ARGS")
    if record:
        with open(record, "a", encoding="utf-8") as f:
            f.write(json.dumps(args, ensure_ascii=False) + "\n")

    prompt = next((a for a in args if a.startswith("依頼文 ")), "")
    m = re.match(r"依頼文 (\S+) のとおりに", prompt)
    request = m.group(1) if m else None
    record_call(args, request)

    stream = os.environ.get("FAKE_CLAUDE_STREAM")
    if stream:
        with open(stream, encoding="utf-8") as f:
            sys.stdout.write(f.read())
    else:
        init = {"type": "system", "subtype": "init", "model": "claude-opus-5",
                "session_id": "s", "parent_tool_use_id": None}
        modes = option_values(args, "--permission-mode")
        mode_in_log = os.environ.get("FAKE_CLAUDE_PERMISSION_MODE", modes[0] if modes else None)
        if mode_in_log is not None:
            init["permissionMode"] = mode_in_log
        print(json.dumps(init))
        print(json.dumps({"type": "assistant", "parent_tool_use_id": None,
                          "message": {"content": [{"type": "tool_use", "name": "Skill",
                                                   "input": {"skill": "code-review"}}]}}))
        print(json.dumps({"type": "result", "subtype": "success", "is_error": False,
                          "permission_denials": []}))
    sys.stdout.flush()

    mode = os.environ.get("FAKE_CLAUDE_MODE", "ok")
    if mode == "hang_ignore_term":
        received = os.environ["FAKE_CLAUDE_TERM_RECEIVED"]
        write_pids(os.getpid())
        signal.signal(signal.SIGTERM, lambda *_: open(received, "w").close())
        while True:
            time.sleep(1)
    if mode == "hang":
        child = subprocess.Popen(["sleep", "1000"])
        write_pids(os.getpid(), child.pid)
        while True:
            time.sleep(1)
    if mode == "hang_leave_child":
        child = subprocess.Popen(["sleep", "1000"])
        detached = subprocess.Popen(["sleep", "1000"], cwd=os.getcwd(), start_new_session=True,
                                    stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL)
        write_pids(os.getpid(), child.pid, detached.pid)
        while True:
            print(json.dumps({"type": "fake_tick"}), flush=True)
            time.sleep(0.2)

    time.sleep(float(os.environ.get("FAKE_CLAUDE_SLEEP", "0")))

    if not request:
        print("fake-claude: プロンプトに依頼文のパスが無い", file=sys.stderr)
        return 3
    with open(request, encoding="utf-8") as f:
        text = f.read()
    out = re.search(r"^出力先: `([^`]+)`", text, re.M)
    rid = re.search(r'^run_id: "([^"]*)"', text, re.M)
    head = re.search(r'^head: "([^"]*)"', text, re.M)
    if not (out and rid and head):
        print("fake-claude: 依頼文に出力先・run_id・head の行が無い", file=sys.stderr)
        return 3
    result = out.group(1)
    content = result_lines(mode, rid.group(1), head.group(1))

    if mode == "symlink_workspace":
        workspace = os.path.dirname(result)
        os.rename(workspace, workspace + ".moved")
        os.symlink(os.environ["FAKE_CLAUDE_LINK_TARGET"], workspace)
    if mode == "write_loop_result":
        with open(os.path.join(os.environ["FAKE_CLAUDE_LOOP"], f"review-{rid.group(1)}.yaml"), "w",
                  encoding="utf-8") as f:
            f.write(content)
    elif mode == "result_symlink":
        target = os.path.join(os.getcwd(), "result-target.yaml")
        with open(target, "w", encoding="utf-8") as f:
            f.write(content)
        os.symlink(target, result)
    elif mode == "result_symlink_outside":
        target = os.environ["FAKE_CLAUDE_OUTSIDE"]
        with open(target, "w", encoding="utf-8") as f:
            f.write(content)
        os.symlink(target, result)
    elif mode == "result_fifo":
        os.mkfifo(result)
    elif mode == "result_dir":
        os.makedirs(result)
    elif mode == "result_large":
        with open(result, "w", encoding="utf-8") as f:
            f.write(content + "# " + "x" * (1024 * 1024) + "\n")
    elif mode != "no_result":
        with open(result, "w", encoding="utf-8") as f:
            f.write(content)

    if mode == "dirty_tree":
        with open(os.path.join(os.environ["FAKE_CLAUDE_REPO"], "README.md"), "a", encoding="utf-8") as f:
            f.write("レビュアが書き足した行\n")
    if mode == "write_request":
        path = os.path.join(os.environ["FAKE_CLAUDE_LOOP"], "review-request-29990101-0000-x-9-code-review-opus.md")
        with open(path, "w", encoding="utf-8") as f:
            f.write("# レビュアが置いた依頼文\n")
    if mode == "git_config":
        write_git_config(os.environ["FAKE_CLAUDE_GIT_MARK"])
    if mode == "leave_child":
        child = subprocess.Popen(["sleep", "1000"], cwd=os.getcwd(), start_new_session=True,
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL)
        write_pids(child.pid)
    if mode == "readonly_dir":
        # Go のモジュールのキャッシュと同じく、ディレクトリを 555、ファイルを 444 にする
        os.makedirs(os.path.join("ro", "sub"))
        with open(os.path.join("ro", "sub", "f.txt"), "w", encoding="utf-8") as f:
            f.write("読み取り専用\n")
        os.chmod(os.path.join("ro", "sub", "f.txt"), 0o444)
        os.chmod(os.path.join("ro", "sub"), 0o555)
        os.chmod("ro", 0o555)

    return int(os.environ.get("FAKE_CLAUDE_EXIT", "0"))


if __name__ == "__main__":
    sys.exit(main())
