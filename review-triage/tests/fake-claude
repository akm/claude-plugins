#!/usr/bin/env python3
"""ワーカーのテストで、PATH の先頭に claude の名前で置く偽のコマンド。

実際の claude -p の代わりに、環境変数の指示どおりに振る舞う。

- FAKE_CLAUDE_ARGS: 受けた引数 (argv[1:]) を JSON の 1 行として追記するファイル
- FAKE_CLAUDE_PIDS: 自分と、起動した子プロセスの PID を書くファイル (mode が hang のとき)
- FAKE_CLAUDE_STREAM: 標準出力に出す stream-json の中身を持つファイル。無ければ既定の 3 行
- FAKE_CLAUDE_SLEEP: 結果を書く前に待つ秒数 (既定 0)
- FAKE_CLAUDE_EXIT: 終了コード (既定 0)
- FAKE_CLAUDE_MODE:
    ok            結果を正しく書く (既定)
    no_result     結果を書かない
    empty_run_id  run_id を空で書く
    no_findings   findings の行を書かない
    dirty_tree    結果を書き、作業ツリーの追跡中のファイルを変える
    write_request 結果を書き、周回の置き場に依頼文を 1 つ置く
    hang          子プロセスを起動して終わらない

プロンプトの「依頼文 <パス> のとおりに」から依頼文を見つけ、依頼文の「出力先: `<パス>`」の行から結果の置き場を読む。
"""

import json
import os
import re
import subprocess
import sys
import time


def main():
    args = sys.argv[1:]
    record = os.environ.get("FAKE_CLAUDE_ARGS")
    if record:
        with open(record, "a", encoding="utf-8") as f:
            f.write(json.dumps(args, ensure_ascii=False) + "\n")

    stream = os.environ.get("FAKE_CLAUDE_STREAM")
    if stream:
        with open(stream, encoding="utf-8") as f:
            sys.stdout.write(f.read())
    else:
        print(json.dumps({"type": "system", "subtype": "init", "model": "claude-opus-5",
                          "session_id": "s", "parent_tool_use_id": None}))
        print(json.dumps({"type": "assistant", "parent_tool_use_id": None,
                          "message": {"content": [{"type": "tool_use", "name": "Skill",
                                                   "input": {"skill": "code-review"}}]}}))
        print(json.dumps({"type": "result", "subtype": "success", "is_error": False,
                          "permission_denials": []}))
    sys.stdout.flush()

    mode = os.environ.get("FAKE_CLAUDE_MODE", "ok")
    if mode == "hang":
        child = subprocess.Popen(["sleep", "1000"])
        pids = os.environ.get("FAKE_CLAUDE_PIDS")
        if pids:
            with open(pids, "w", encoding="utf-8") as f:
                f.write(f"{os.getpid()} {child.pid}\n")
        while True:
            time.sleep(1)

    time.sleep(float(os.environ.get("FAKE_CLAUDE_SLEEP", "0")))

    prompt = next((a for a in args if a.startswith("依頼文 ")), "")
    m = re.match(r"依頼文 (\S+) のとおりに", prompt)
    if not m:
        print("fake-claude: プロンプトに依頼文のパスが無い", file=sys.stderr)
        return 3
    request = m.group(1)
    with open(request, encoding="utf-8") as f:
        text = f.read()
    out = re.search(r"^出力先: `([^`]+)`", text, re.M)
    rid = re.search(r'^run_id: "([^"]*)"', text, re.M)
    head = re.search(r'^head: "([^"]*)"', text, re.M)
    if not (out and rid and head):
        print("fake-claude: 依頼文に出力先・run_id・head の行が無い", file=sys.stderr)
        return 3
    result = out.group(1)

    if mode != "no_result":
        lines = [
            "skill: code-review",
            "model: opus",
            'level: "high"',
            'run_id: ""' if mode == "empty_run_id" else f'run_id: "{rid.group(1)}"',
            "scope: full",
            f'head: "{head.group(1)}"',
        ]
        if mode != "no_findings":
            lines.append("findings: []")
        lines.append("residual: []")
        with open(result, "w", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")

    if mode == "dirty_tree":
        with open("README.md", "a", encoding="utf-8") as f:
            f.write("レビュアが書き足した行\n")
    if mode == "write_request":
        loop_dir = os.path.dirname(request)
        path = os.path.join(loop_dir, "review-request-29990101-0000-x-9-code-review-opus.md")
        with open(path, "w", encoding="utf-8") as f:
            f.write("# レビュアが置いた依頼文\n")

    return int(os.environ.get("FAKE_CLAUDE_EXIT", "0"))


if __name__ == "__main__":
    sys.exit(main())
