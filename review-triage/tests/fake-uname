#!/bin/sh
# ワーカーのテストで、PATH の先頭に uname の名前で置く偽のコマンド。
#
# ワーカーは起動時の確認で `uname -s` が Darwin (macOS) であることを確かめる。CI は ubuntu で走るので、
# 本物の uname のままだと、すべてのテストがその確認で止まる。
#
# - `uname -s` には、環境変数 FAKE_UNAME_S の値を返す。無ければ Darwin を返す。
# - それ以外の引数は、本物の uname にそのまま渡す。

if [ "$#" -eq 1 ] && [ "$1" = "-s" ]; then
  echo "${FAKE_UNAME_S:-Darwin}"
  exit 0
fi
for u in /usr/bin/uname /bin/uname; do
  if [ -x "$u" ]; then
    exec "$u" "$@"
  fi
done
echo "fake-uname: 本物の uname が /usr/bin にも /bin にも無い" >&2
exit 1
